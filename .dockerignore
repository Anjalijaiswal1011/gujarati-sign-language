# Ignore git files
.git
.gitignore

# Ignore local virtual environments
venv/
backend/venv/
backend/env/
backend/.venv/
.venv/
env/
ENV/

# Ignore local databases and SQLite journals
backend/db.sqlite3
backend/db.sqlite3-journal

# Ignore local media assets and audio recordings (to save image size)
backend/*.mp3
backend/test_voice*.mp3
backend/voice_gu_*.mp3
backend/media/

# Ignore compiled python files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore IDE and settings files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Ignore OS files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
